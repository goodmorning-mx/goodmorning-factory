{
  "topology": "resources-v3",
  "product": "helloworld",
  "repository": "goodmorning-mx/helloworld",
  "branch": "dev",
  "development_domain": "dev.helloworld.goodmorning.mx",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.dev.helloworld.goodmorning.mx",
      "health_path": "/health",
      "auto_deploy": true,
      "environment": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "resource": "postgres",
          "driver": "psycopg"
        }
      ]
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://dev.helloworld.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": true,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "literal",
          "value": "https://api.dev.helloworld.goodmorning.mx"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 3 * * *",
    "local_retention_count": 1,
    "local_retention_days": 1,
    "s3_retention_count": 7,
    "s3_retention_days": 7,
    "timeout_seconds": 1800
  }
}
