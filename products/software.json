{
  "frontend_profile": "react",
  "topology": "resources-v3",
  "product": "software",
  "repository": "goodmorning-mx/software",
  "branch": "dev",
  "development_domain": "dev.software.goodmorning.mx",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.dev.software.goodmorning.mx",
      "health_path": "/health",
      "auto_deploy": true,
      "include_source_commit_in_build": true,
      "environment": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "resource": "postgres",
          "driver": "psycopg"
        },
        {"key": "APP_ENV", "source": "literal", "value": "development"},
        {"key": "CORS_ORIGINS", "source": "literal", "value": "https://dev.software.goodmorning.mx"},
        {"key": "AUTH_JWT_SECRET", "source": "generated_secret"},
        {"key": "AUTH_BOOTSTRAP_SECRET", "source": "generated_secret"},
        {"key": "GITHUB_OIDC_AUDIENCE", "source": "literal", "value": "software.goodmorning.mx"},
        {"key": "GITHUB_OIDC_REPOSITORY_ID", "source": "literal", "value": "1298125378"},
        {"key": "GITHUB_OIDC_ALLOWED_WORKFLOWS", "source": "literal", "value": "goodmorning-mx/goodmorning-factory/.github/workflows/provision-coolify-advanced-development.yml@refs/heads/dev"}
      ]
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://dev.software.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": true,
      "include_source_commit_in_build": true,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "literal",
          "value": "https://api.dev.software.goodmorning.mx"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 3 * * *",
    "local_retention_count": 1,
    "local_retention_days": 1,
    "s3_retention_count": 7,
    "s3_retention_days": 7,
    "timeout_seconds": 1800
  }
}
