{
  "frontend_profile": "react",
  "topology": "resources-v3",
  "product": "lesbianapp",
  "repository": "goodmorning-mx/lesbianapp",
  "branch": "dev",
  "modules": [
    {
      "name": "gm-pwa",
      "version": "0.1.4",
      "kind": "frontend",
      "frontend_package": "@goodmorning/gm-pwa",
      "node_requires": ["react>=18"],
      "deployment_modes": ["embedded"],
      "default_deployment_mode": "embedded",
      "resource_requirements": [],
      "bindings": [],
      "pwa": {
        "manifest_required": true,
        "service_worker_required": true,
        "update_mode": "prompt",
        "api_auth_cache": "network-only"
      },
      "compatibility": {"node": ">=20", "factory_api": "^1.0", "products": ["lesbianapp"]}
    },
    {
      "name": "gm-auth",
      "version": "0.1.4",
      "kind": "full-stack",
      "backend_package": "gm-auth",
      "frontend_package": "@goodmorning/gm-auth",
      "python_requires": [">=3.12"],
      "node_requires": ["react>=18", "react-dom>=18"],
      "deployment_modes": ["embedded", "service"],
      "default_deployment_mode": "embedded",
      "resource_requirements": [
        {"name": "primary-db", "kind": "postgresql", "resource_name": "postgres", "shared": true}
      ],
      "bindings": [
        {"key": "DATABASE_URL", "source": "database_url", "requirement": "primary-db", "target": "backend", "driver": "psycopg"},
        {"key": "AUTH_SECRET", "source": "generated_secret", "target": "backend"}
      ],
      "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["lesbianapp"]}
    }
  ],
  "development_domain": "dev.lesbianapp.goodmorning.mx",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.dev.lesbianapp.goodmorning.mx",
      "health_path": "/health",
      "auto_deploy": true,
      "environment": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "resource": "postgres",
          "driver": "psycopg"
        },
        {
          "key": "APP_NAME",
          "source": "literal",
          "value": "Lesbianapp API"
        },
        {
          "key": "APP_ENV",
          "source": "literal",
          "value": "dev"
        },
        {
          "key": "CORS_ORIGINS",
          "source": "literal",
          "value": "https://dev.lesbianapp.goodmorning.mx"
        },
        {
          "key": "AUTH_SECRET",
          "source": "generated_secret"
        }
      ]
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://dev.lesbianapp.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": true,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "literal",
          "value": "https://api.dev.lesbianapp.goodmorning.mx"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 3 * * *",
    "local_retention_count": 1,
    "local_retention_days": 1,
    "s3_retention_count": 7,
    "s3_retention_days": 7,
    "timeout_seconds": 1800
  }
}
