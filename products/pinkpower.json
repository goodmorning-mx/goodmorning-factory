      "deployment_modes": [
        "embedded",
        "service"
      ],
      "frontend_package": "@goodmorning/gm-billing",
      "kind": "full-stack",
      "migrations": {
        "minimum_schema": 1,
        "mode": "sql",
        "path": "migrations"
      },
      "name": "gm-billing",
      "resource_requirements": [],
      "version": "0.1.1"
    },
    {
      "backend_package": "gm-auth",
      "bindings": [
        {
          "key": "DATABASE_URL",
          "requirement": "primary-db",
          "source": "database_url",
