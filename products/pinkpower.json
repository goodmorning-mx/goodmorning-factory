        "python": ">=3.12"
      },
      "default_deployment_mode": "embedded",
      "dependencies": [],
      "deployment_modes": [
        "embedded",
        "service"
      ],
      "env": [],
      "frontend_package": "@goodmorning/gm-auth",
      "kind": "full-stack",
      "migrations": {
        "minimum_schema": 1,
        "mode": "sql",
        "path": "migrations"
