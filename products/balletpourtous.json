{
    "topology": "resources-v2",
    "product": "balletpourtous",
    "repository": "goodmorning-mx/balletpourtous",
    "branch": "dev",
    "development_domain": "dev.balletpourtous.goodmorning.mx",
    "coolify_github_app_name": "goodmorning-mx-coolify",
    "backend_base_directory": "/backend",
  "frontend_base_directory": "/frontend",
  "modules": [
    {
      "name": "gm-mcp",
      "version": "0.1.0",
      "kind": "backend",
      "backend_package": "gm-mcp",
      "dependencies": [],
      "compatibility": {"python": ">=3.12", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-billing",
      "version": "0.1.1",
      "kind": "full-stack",
      "backend_package": "gm-billing",
      "frontend_package": "@goodmorning/gm-billing",
      "dependencies": [],
      "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-agent",
      "version": "0.1.2",
      "kind": "full-stack",
      "backend_package": "gm-agent",
      "frontend_package": "@goodmorning/gm-agent",
      "python_requires": ["gm-mcp>=0.1.0", "gm-billing>=0.1.1"],
      "node_requires": ["react>=18"],
      "env": [
        {"key": "OPENAI_API_KEY", "required": true, "secret": true},
        {"key": "AGENT_MODEL", "required": true, "default": "gpt-4o-mini"}
      ],
      "dependencies": ["gm-mcp", "gm-billing"],
      "migrations": {"mode": "none"},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    }
  ],
  "backup": {
        "enabled": true,
        "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
        "frequency": "0 3 * * *",
        "local_retention_count": 1,
        "local_retention_days": 1,
        "s3_retention_count": 7,
        "s3_retention_days": 7,
        "timeout_seconds": 1800
    }
}
