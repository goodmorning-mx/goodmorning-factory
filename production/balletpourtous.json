{
  "topology": "resources-v3-production",
  "product": "balletpourtous",
  "repository": "goodmorning-mx/balletpourtous",
  "branch": "main",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "migration": {
    "from_topology": "resources-v2-production",
    "mode": "adopt-in-place",
    "retain": true,
    "resource_names": {
      "applications": ["balletpourtous-api-prod", "balletpourtous-frontend-prod"],
      "databases": ["balletpourtous-postgres-prod"],
      "redis": []
    },
    "resource_uuids": {
      "balletpourtous-frontend-prod": "iwdsxxgit6l168v9u4v4ww0g"
    },
    "preserve": ["resources", "uuids", "databases", "volumes", "domains", "secrets", "configuration"]
  },
  "confirm_production": true,
  "promotion_policy": "auto-on-main",
  "module_update_policy": {
    "default": {"patch": "auto", "minor": "manual", "major": "blocked"},
    "modules": {"gm-pwa": {"patch": "auto"}}
  },
  "modules": [
    {
      "name": "gm-pwa", "version": "0.1.4", "kind": "frontend",
      "frontend_package": "@goodmorning/gm-pwa", "deployment_modes": ["embedded"],
      "default_deployment_mode": "embedded", "resource_requirements": [], "bindings": [],
      "node_requires": ["react>=18"], "env": [], "required_secrets": {}, "dependencies": [],
      "migrations": {"mode": "none"},
      "pwa": {"manifest_required": true, "service_worker_required": true, "update_mode": "prompt", "api_auth_cache": "network-only"},
      "compatibility": {"node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-mcp", "version": "0.3.1", "kind": "backend",
      "backend_package": "gm-mcp", "deployment_modes": ["embedded", "gateway"],
      "deployment_mode": "gateway",
      "default_deployment_mode": "embedded",
      "resource_requirements": [{"name": "primary-db", "kind": "postgresql", "resource_name": "postgres", "shared": true, "deployment_modes": ["gateway"]}, {"name": "mcp-gateway", "kind": "gateway", "resource_name": "mcp-gateway", "shared": true, "deployment_modes": ["gateway"], "dockerfile": "/Dockerfile.mcp", "base_directory": "/backend", "port": 8200, "public": true, "health_path": "/health"}],
      "bindings": [{"key": "DATABASE_URL", "source": "database_url", "requirement": "primary-db", "target": "mcp-gateway", "driver": "psycopg"}, {"key": "MCP_OAUTH_SECRET", "source": "generated_secret", "target": "mcp-gateway"}], "dependencies": [],
      "compatibility": {"python": ">=3.12", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-billing", "version": "0.1.1", "kind": "full-stack",
      "backend_package": "gm-billing", "frontend_package": "@goodmorning/gm-billing",
      "deployment_modes": ["embedded", "service"], "default_deployment_mode": "embedded",
      "resource_requirements": [], "bindings": [], "dependencies": [],
      "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-auth", "version": "0.1.4", "kind": "full-stack",
      "backend_package": "gm-auth", "frontend_package": "@goodmorning/gm-auth",
      "deployment_modes": ["embedded", "service"], "default_deployment_mode": "embedded",
      "resource_requirements": [{"name": "primary-db", "kind": "postgresql", "resource_name": "postgres", "shared": true}],
      "bindings": [{"key": "DATABASE_URL", "source": "database_url", "requirement": "primary-db", "target": "backend", "driver": "psycopg"}],
      "node_requires": ["react>=18"], "env": [], "required_secrets": {}, "dependencies": [],
      "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    },
    {
      "name": "gm-agent", "version": "0.1.4", "kind": "full-stack",
      "backend_package": "gm-agent", "frontend_package": "@goodmorning/gm-agent",
      "deployment_modes": ["embedded", "service", "gateway"], "default_deployment_mode": "embedded",
      "resource_requirements": [{"name": "agent-gateway", "kind": "gateway", "resource_name": "agent-gateway", "deployment_modes": ["gateway"], "port": 8100, "public": true}],
      "bindings": [], "python_requires": ["gm-mcp>=0.3.1", "gm-billing>=0.1.1"], "node_requires": ["react>=18"],
      "env": [{"key": "AGENT_MODEL", "required": true, "default": "gpt-4o-mini"}],
      "required_secrets": {"OPENAI_API_KEY": {"source": "GOODMORNING_MANAGED", "binding": "goodmorning/openai-default", "target": "backend"}},
      "dependencies": ["gm-mcp", "gm-billing"], "migrations": {"mode": "none"},
      "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["balletpourtous"]}
    }
  ],
  "applications": [
    {
      "name": "api", "role": "api", "base_directory": "/backend", "dockerfile": "/Dockerfile", "port": 8000,
      "domain": "https://api.balletpourtous.goodmorning.mx", "health_path": "/health", "auto_deploy": true,
      "environment": [], "dependencies": ["postgres"]
    },
    {
      "name": "frontend", "role": "frontend", "base_directory": "/frontend", "dockerfile": "/Dockerfile", "port": 80,
      "domain": "https://balletpourtous.goodmorning.mx", "health_path": "/", "auto_deploy": true,
      "environment": [], "dependencies": []
    },
    {
      "name": "mcp-gateway", "role": "gateway", "base_directory": "/backend", "dockerfile": "/Dockerfile.mcp", "port": 8200,
      "domain": "https://mcp-gateway.balletpourtous.goodmorning.mx", "health_path": "/health", "auto_deploy": true,
      "environment": [
        {"key": "APP_ENV", "source": "literal", "value": "prod"},
        {"key": "MCP_PUBLIC_URL", "source": "literal", "value": "https://mcp-gateway.balletpourtous.goodmorning.mx/mcp"}
      ], "dependencies": ["postgres"]
    }
  ],
  "databases": [
    {"name": "postgres", "engine": "postgresql", "version": "16", "image": "postgres:16-alpine", "public": false, "backup": true}
  ],
  "redis": [],
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 2 * * *",
    "local_retention_count": 2,
    "local_retention_days": 2,
    "s3_retention_count": 30,
    "s3_retention_days": 30,
    "timeout_seconds": 1800
  }
}
