{
  "topology": "resources-v3-production",
  "product": "hosting",
  "repository": "goodmorning-mx/hosting",
  "branch": "main",
  "modules": [
    {
      "name": "gm-auth",
      "version": "0.1.4",
      "kind": "full-stack",
      "backend_package": "gm-auth",
      "frontend_package": "@goodmorning/gm-auth",
      "deployment_modes": [
        "embedded",
        "service"
      ],
      "default_deployment_mode": "embedded",
      "deployment_mode": "embedded",
      "resource_requirements": [],
      "bindings": [],
      "migrations": {
        "mode": "sql",
        "path": "migrations",
        "minimum_schema": 1
      },
      "compatibility": {
        "python": ">=3.12",
        "node": ">=20",
        "factory_api": "^1.0",
        "products": [
          "hosting"
        ]
      }
    }
  ],
  "development_domain": "hosting.goodmorning.mx",
  "confirm_production": true,
  "promotion_policy": "auto-on-main",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.hosting.goodmorning.mx",
      "custom_domains": [
        "https://environtx.hosting.goodmorning.mx",
        "https://hipposburgers.hosting.goodmorning.mx",
        "https://nysweety.hosting.goodmorning.mx",
        "https://vitaliahemodialisis.hosting.goodmorning.mx",
        "https://capitalqualitydemexico.hosting.goodmorning.mx",
        "https://impulsemexico.hosting.goodmorning.mx",
        "https://inbrainwebpage.hosting.goodmorning.mx",
        "https://inbrainwebpage.goodmorning.mx",
        "https://vitaliahemodialisis.com",
        "https://www.vitaliahemodialisis.com",
        "https://crazyitpizza.hosting.goodmorning.mx",
        "https://crazyitpizza.com"
      ],
      "health_path": "/health",
      "auto_deploy": true,
      "environment": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "resource": "postgres",
          "driver": "psycopg"
        },
        {
          "key": "AUTH_SECRET",
          "source": "generated_secret"
        },
        {
          "key": "API_HOST",
          "source": "literal",
          "value": "api.hosting.goodmorning.mx"
        },
        {
          "key": "PUBLICATION_PROBE_ORIGIN",
          "source": "literal",
          "value": "https://api.hosting.goodmorning.mx"
        },
        {
          "key": "CORS_ORIGINS",
          "source": "literal",
          "value": "https://hosting.goodmorning.mx"
        },
        {
          "key": "SITES_DOMAIN",
          "source": "literal",
          "value": "hosting.goodmorning.mx"
        },
        {
          "key": "ADMIN_BOOTSTRAP_PASSWORD_HASH",
          "source": "managed_secret",
          "binding": "HOSTING_ADMIN_BOOTSTRAP_PASSWORD_HASH"
        },
        {
          "key": "ADMIN_BOOTSTRAP_EMAIL",
          "source": "literal",
          "value": "mastertreck@goodmorning.mx"
        }
      ],
      "persistent_volume": {
        "name": "hosting-backend-data",
        "mount_path": "/app/data"
      }
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://hosting.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": true,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "service_url",
          "resource": "api"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 3 * * *",
    "local_retention_count": 1,
    "local_retention_days": 1,
    "s3_retention_count": 7,
    "s3_retention_days": 7,
    "timeout_seconds": 1800
  }
}
