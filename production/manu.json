{
  "frontend_profile": "react",
  "topology": "resources-v3-production",
  "product": "manu",
  "repository": "goodmorning-mx/manu",
  "branch": "main",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.manu.goodmorning.mx",
      "health_path": "/health",
      "auto_deploy": false,
      "environment": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "resource": "postgres",
          "driver": "psycopg"
        },
        {
          "key": "APP_NAME",
          "source": "literal",
          "value": "Manu Reviews API"
        },
        {
          "key": "APP_ENV",
          "source": "literal",
          "value": "production"
        },
        {
          "key": "ORGANIZATION_ID",
          "source": "literal",
          "value": "manu"
        },
        {
          "key": "AUTH_SECRET",
          "source": "generated_secret"
        }
      ]
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://manu.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": false,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "literal",
          "value": "https://api.manu.goodmorning.mx"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "confirm_production": true,
  "promotion_policy": "auto-on-main",
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 2 * * *",
    "local_retention_count": 2,
    "local_retention_days": 2,
    "s3_retention_count": 30,
    "s3_retention_days": 30,
    "timeout_seconds": 1800
  },
  "modules": [
    {
      "name": "gm-auth",
      "version": "0.1.5",
      "source_commit": "138d66cb44a94781e0d38d8afd1be2dbf718c294",
      "kind": "full-stack",
      "backend_package": "gm-auth",
      "frontend_package": "@goodmorning/gm-auth",
      "python_requires": [],
      "node_requires": [
        "react>=18",
        "react-dom>=18"
      ],
      "deployment_modes": [
        "embedded",
        "service"
      ],
      "default_deployment_mode": "embedded",
      "resource_requirements": [
        {
          "name": "primary-db",
          "kind": "postgresql",
          "resource_name": "postgres",
          "shared": true
        }
      ],
      "bindings": [
        {
          "key": "DATABASE_URL",
          "source": "database_url",
          "requirement": "primary-db",
          "target": "backend"
        }
      ],
      "dependencies": [],
      "env": [],
      "required_secrets": {},
      "migrations": {
        "mode": "sql",
        "path": "migrations",
        "minimum_schema": 1
      },
      "compatibility": {
        "python": ">=3.12",
        "node": ">=20",
        "factory_api": "^1.0",
        "products": [
          "*"
        ]
      }
    }
  ]
}
