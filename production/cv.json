{
  "topology": "resources-v3-production",
  "product": "cv",
  "repository": "goodmorning-mx/cv",
  "branch": "main",
  "coolify_github_app_name": "goodmorning-mx-coolify",
  "modules": [
    {
      "name": "gm-pwa", "version": "0.1.4", "kind": "frontend", "frontend_package": "@goodmorning/gm-pwa", "node_requires": ["react>=18"],
      "deployment_modes": ["embedded"], "default_deployment_mode": "embedded", "resource_requirements": [], "bindings": [], "dependencies": [], "env": [], "required_secrets": {}, "migrations": {"mode": "none"},
      "pwa": {"manifest_required": true, "service_worker_required": true, "update_mode": "prompt", "api_auth_cache": "network-only"}, "compatibility": {"node": ">=20", "factory_api": "^1.0", "products": ["cv"]}
    },
    {
      "name": "gm-mcp", "version": "0.3.1", "kind": "backend", "backend_package": "gm-mcp", "deployment_modes": ["embedded", "gateway"], "default_deployment_mode": "embedded", "resource_requirements": [], "bindings": [], "dependencies": [], "env": [], "required_secrets": {}, "migrations": {"mode": "none"}, "compatibility": {"python": ">=3.12", "factory_api": "^1.0", "products": ["cv"]}
    },
    {
      "name": "gm-billing", "version": "0.1.1", "kind": "full-stack", "backend_package": "gm-billing", "frontend_package": "@goodmorning/gm-billing", "python_requires": [], "node_requires": ["react>=18"], "deployment_modes": ["embedded", "service"], "default_deployment_mode": "embedded", "resource_requirements": [], "bindings": [], "dependencies": [], "env": [], "required_secrets": {}, "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1}, "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["cv"]}
    },
    {
      "name": "gm-auth", "version": "0.1.4", "kind": "full-stack", "backend_package": "gm-auth", "frontend_package": "@goodmorning/gm-auth", "node_requires": ["react>=18"], "deployment_modes": ["embedded", "service"], "default_deployment_mode": "embedded", "resource_requirements": [{"name": "primary-db", "kind": "postgresql", "resource_name": "postgres", "shared": true}], "bindings": [{"key": "DATABASE_URL", "source": "database_url", "requirement": "primary-db", "target": "backend"}], "dependencies": [], "env": [], "required_secrets": {}, "migrations": {"mode": "sql", "path": "migrations", "minimum_schema": 1}, "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["cv"]}
    },
    {
      "name": "gm-agent", "version": "0.1.5", "kind": "full-stack", "backend_package": "gm-agent", "frontend_package": "@goodmorning/gm-agent", "python_requires": ["gm-mcp>=0.3.1", "gm-billing>=0.1.1"], "node_requires": ["react>=18"], "deployment_modes": ["embedded", "service", "gateway"], "default_deployment_mode": "embedded", "resource_requirements": [], "bindings": [], "dependencies": ["gm-mcp", "gm-billing"], "env": [{"key": "AGENT_MODEL", "required": true, "default": "gpt-4o-mini"}], "required_secrets": {"OPENAI_API_KEY": {"source": "GOODMORNING_MANAGED", "binding": "goodmorning/openai-default", "target": "backend"}}, "migrations": {"mode": "none"}, "compatibility": {"python": ">=3.12", "node": ">=20", "factory_api": "^1.0", "products": ["cv"]}
    }
  ],
  "applications": [
    {
      "name": "api",
      "role": "api",
      "base_directory": "/backend",
      "dockerfile": "/Dockerfile",
      "port": 8000,
      "domain": "https://api.cv.goodmorning.mx",
      "health_path": "/health",
      "auto_deploy": true,
      "environment": [
        {"key": "APP_ENV", "source": "literal", "value": "production"},
        {"key": "CORS_ORIGINS", "source": "literal", "value": "https://cv.goodmorning.mx"},
        {"key": "AGENT_MODEL", "source": "literal", "value": "gpt-4o-mini"},
        {"key": "AUTH_SECRET", "source": "generated_secret"},
        {"key": "MCP_OAUTH_SECRET", "source": "generated_secret"}
      ]
    },
    {
      "name": "frontend",
      "role": "frontend",
      "base_directory": "/frontend",
      "dockerfile": "/Dockerfile",
      "port": 80,
      "domain": "https://cv.goodmorning.mx",
      "health_path": "/",
      "auto_deploy": true,
      "environment": [
        {
          "key": "VITE_API_URL",
          "source": "literal",
          "value": "https://api.cv.goodmorning.mx"
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "engine": "postgresql",
      "version": "16",
      "image": "postgres:16-alpine",
      "public": false,
      "backup": true
    }
  ],
  "redis": [],
  "confirm_production": true,
  "promotion_policy": "auto-on-main",
  "backup": {
    "enabled": true,
    "storage_uuid": "c1rrntk8wv4cf3tl3wqviwp3",
    "frequency": "0 2 * * *",
    "local_retention_count": 2,
    "local_retention_days": 2,
    "s3_retention_count": 30,
    "s3_retention_days": 30,
    "timeout_seconds": 1800
  }
}
